# Environment for running the live suites against Hardcharger (source it, then set the binary):
#   set -a; . scripts/live-hardcharger.env.example; set +a
#   export CHARGEWIRE_JS_TEST_SERVER_BINARY=/path/to/hardcharger-server
CHARGEWIRE_JS_TEST_SERVER_PASSWORD_ENV=HARDCHARGER_ADMIN_PASSWORD
CHARGEWIRE_JS_TEST_SERVER_USERNAME_FLAG=--admin-username
CHARGEWIRE_JS_TEST_SERVER_MTLS_FLAG=--mtls-ca-cert
CHARGEWIRE_JS_TEST_SERVER_CORS_FLAG=--cors-origins
CHARGEWIRE_JS_TEST_SERVER_NAME=Hardcharger
# Browser sign-in (test/live/oauth.test.ts): Hardcharger's flags for the mock provider.
CHARGEWIRE_JS_TEST_SERVER_OAUTH_ARGS="--token-allowed-issuer {issuer} --token-allowed-audience {client_id} --token-default-role admin --token-authorized-emails {identity} --oauth-client-id {client_id} --oauth-base-url http://127.0.0.1:{port}"
CHARGEWIRE_JS_TEST_SERVER_OAUTH_SECRET_ENV=HARDCHARGER_OAUTH_CLIENT_SECRET
