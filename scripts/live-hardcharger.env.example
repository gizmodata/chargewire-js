# Environment for running the live suites against Hardcharger (source it, then set the binary):
#   set -a; . scripts/live-hardcharger.env.example; set +a
#   export WARP_SQL_JS_TEST_SERVER_BINARY=/path/to/hardcharger-server
WARP_SQL_JS_TEST_SERVER_PASSWORD_ENV=HARDCHARGER_ADMIN_PASSWORD
WARP_SQL_JS_TEST_SERVER_USERNAME_FLAG=--admin-username
WARP_SQL_JS_TEST_SERVER_MTLS_FLAG=--mtls-ca-cert
WARP_SQL_JS_TEST_SERVER_CORS_FLAG=--cors-origins
WARP_SQL_JS_TEST_SERVER_NAME=Hardcharger
